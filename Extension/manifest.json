{
  "manifest_version": 3,
  "name": "TorrANT Catcher",
  "version": "0.1.0",
  "description": "Hands every Brave download to TorrANT. No crumb too big.",
  "key": "",
  "permissions": ["downloads", "cookies", "nativeMessaging", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "TorrANT Catcher",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
